<?xml version="1.0" encoding="utf-8"?>
<!-- The package name of "RG552 Boot Switch", which this app replaces: the two never sit side by side. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.darkmoss.rg552bootswitch">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.SpruceOS"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
