<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Full screen on the spruce theme grey, so nothing flashes white before the first frame. -->
    <style name="Theme.SpruceOS.Base" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/spruce_bg</item>
        <item name="android:colorBackground">@color/spruce_bg</item>
        <item name="android:colorPrimary">@color/spruce_bg</item>
        <item name="android:colorPrimaryDark">@color/spruce_bg</item>
        <item name="android:colorAccent">@color/spruce_text</item>
        <item name="android:statusBarColor">@color/spruce_bg</item>
        <item name="android:navigationBarColor">@color/spruce_bg</item>
    </style>

    <style name="Theme.SpruceOS" parent="Theme.SpruceOS.Base" />
</resources>
