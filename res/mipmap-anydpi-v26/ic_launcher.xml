<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+): spruce's tree on the spruce theme grey. The monochrome layer is what
     Android 13+ draws, tinted to the wallpaper's Material You colours, when themed icons are on. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/spruce_bg" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
